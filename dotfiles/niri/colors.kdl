layout {
	background-color "#19120d"

    focus-ring {
        active-color "#ffb781"
        inactive-color "#9f8d82"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb781"
        inactive-color "#9f8d82"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb781"
        inactive-color "#9f8d82"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb78180"
    }
}

overview {
	backdrop-color "#19120d"
}

recent-windows {
    highlight {
        active-color "#ffb781"
        urgent-color "#ffb4ab"
    }
}
